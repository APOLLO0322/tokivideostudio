# お申し込みフォーム（/apply → POST /api/apply）のメール送信設定
# Vercel の Settings → Environment Variables に同じ3つを登録する。

# Resend（https://resend.com）のAPIキー。登録後 API Keys から発行。
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 申し込み内容の送信先。カンマ区切りで複数指定できる。
# 【暫定運用の注意】送信元が onboarding@resend.dev の間は、
# Resendに登録したアカウントのメールアドレス宛にしか送信できない。
APPLY_MAIL_TO=tokivideostudio.apollo@gmail.com

# 送信元。
# 暫定: onboarding@resend.dev（ドメイン認証なしで即使える。宛先は上記の制限あり）
# 本番: Resendでtokivideostudio-apollo.comを認証後、そのドメインのアドレスに変更する
#       例）APPLY_MAIL_FROM=トキ映像製作所 <noreply@tokivideostudio-apollo.com>
APPLY_MAIL_FROM=onboarding@resend.dev
